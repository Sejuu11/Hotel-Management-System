# Server Configuration
PORT=3000
NODE_ENV=development

# Neon PostgreSQL Connection URL
# Get this from your Neon Console (https://console.neon.tech)
# Make sure "?sslmode=require" is included
DATABASE_URL=postgresql://user:password@ep-xyz-123456.us-east-2.aws.neon.tech/hotel_management?sslmode=require

# JWT Secret for Session Authentication
# In production on Render, generate a strong random 32+ character key
JWT_SECRET=your_jwt_secret_key_change_for_production_min_32_chars

# Optional Demo Credentials
DEMO_USERNAME=admin
DEMO_PASSWORD=admin123
